NODE_ENV=development
PORT=3000
# ローカル開発用（SSLなし）
DATABASE_URL=postgresql://user:password@localhost:5432/cheerstick
# Render.com本番用の形式（Render管理画面の "External Database URL" をコピーして使用）
# DATABASE_URL=postgresql://user:password@<host>.oregon-postgres.render.com/cheerstick?sslmode=require
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.example.com
REFERENCE_TOKEN_SECRET=

# 画像アップロード機能（改善3件フェーズ2、2026-09-16新設）
# 保存先ディレクトリ（絶対パス推奨）。本番は /var/www/cheerstick-app/images/uploads
UPLOAD_DIR=./public/uploads
# アップロード画像の公開URLのベース（本番は https://app.cheerstick.com/images/uploads）
UPLOAD_URL_BASE=http://localhost:3000/uploads
