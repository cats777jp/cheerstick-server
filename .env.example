NODE_ENV=development
PORT=3000
# ローカル開発用（SSLなし）
DATABASE_URL=postgresql://user:password@localhost:5432/cheerstick
# Render.com本番用の形式（Render管理画面の "External Database URL" をコピーして使用）
# DATABASE_URL=postgresql://user:password@<host>.oregon-postgres.render.com/cheerstick?sslmode=require
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.example.com
REFERENCE_TOKEN_SECRET=

# 画像アップロード機能（改善3件フェーズ2、2026-09-16新設）
# 保存先ディレクトリ（絶対パス推奨）。本番は /var/www/cheerstick-app/images/uploads
UPLOAD_DIR=./public/uploads
# アップロード画像の公開URLのベース（本番は https://app.cheerstick.com/images/uploads）
UPLOAD_URL_BASE=http://localhost:3000/uploads

# レート制限（大規模イベント対応、トラックA、2026-09-28新設）
# いずれも未設定なら下記の既定値で動く。数値でない・負の値は既定値へ戻り警告がログに出る。
# src/middleware/rateLimit.js参照。
#
# すべてのリミッターの時間枠（ミリ秒）
RL_WINDOW_MS=900000
# 観客の入口（geturl・reference）：IPごとの上限。1つのIPに1万人分が集約される
# 会場Wi-Fiを想定した値（再接続を含めて数回ずつ呼ぶ場合を許容する）
RL_AUDIENCE_IP_MAX=50000
# 観客の入口：デバイスごとの上限（idクエリ/referenceのtoken方式から取り出したMAC単位）。
# IDが無い・不正な形式の場合はこの上限を適用せず、IPごとの上限のみ適用する
RL_DEVICE_MAX=60
# スコア・閲覧系（会場スクリーン用の読み取りAPI）：IPごとの上限
RL_SCORE_IP_MAX=6000
# 管理API（/api/v1/admin/*）：IPごとの上限（暴走の検知用。nginxのオフィスIP制限は別途有効）
RL_ADMIN_IP_MAX=20000
# それ以外の/api/v1と/health：IPごとの上限（従来の挙動を維持）
RL_DEFAULT_IP_MAX=500
# スコア・閲覧系のサーバー側キャッシュ有効期間（ミリ秒）。0で無効
SCORE_CACHE_TTL_MS=1000
